<h1>オイコンくる26卒で抜けてる人いたら作って埋めといて欲しい！</h1>

<% @tweets.each do |t| %>
    <p>
    <% if t.image.attached? %>
        <%= image_tag t.image,style: "border-radius: 0%; width: 360px; height: 240px; object-fit:cover;" %>
    <% else %>
        ない
    <% end %>
<br>
名前：<%= link_to t.name, tweet_path(t.id), class: "tweet-title" if t.name? %>
<br>
年：<%= t.year %>
<br>
自己紹介：<%= t.profile %>
<br>
住所：<%= t.place %>
<br>
職業：<%= t.job %>
<br>
趣味：<%= t.hobby %>
<br>
    </p>
<% end %>
  <%=link_to "新規投稿",new_tweet_path, class: 'geek' %>
